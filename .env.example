# DC-Masters Container Toolkit Configuration
# Copy this file to .env and configure with your credentials

# Container Runtime (podman or docker)
CONTAINER_RUNTIME=podman

# PostgreSQL Configuration
POSTGRES_USER=dcmasters
POSTGRES_PASSWORD=changeme123
POSTGRES_DB=litellm

# LiteLLM Configuration
LITELLM_MASTER_KEY=sk-1234-changeme
LITELLM_LOG=DEBUG # Set log level to DEBUG for detailed logging (change to INFO or WARNING in production)
DATABASE_URL=postgresql://dcmasters:changeme123@postgres:5432/litellm
# LiteLLM UI Credentials (matches N8N for consistency)
UI_USERNAME=admin@dcmasters.local
UI_PASSWORD=changeme123

# N8N Configuration
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=dcmasters
DB_POSTGRESDB_PASSWORD=changeme123
GENERIC_TIMEZONE=Asia/Singapore
TZ=Asia/Singapore

# N8N Owner Account (auto-created on first startup, skips registration)
N8N_OWNER_EMAIL=admin@dcmasters.local
N8N_OWNER_FIRST_NAME=Admin
N8N_OWNER_LAST_NAME=User
N8N_OWNER_PASSWORD=changeme123

# Azure OpenAI Configuration (for GPT models)
# AZURE_API_KEY=your-azure-api-key
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-15-preview

# AWS Bedrock Configuration (for Claude models)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION_NAME=us-east-1

# Google Cloud / Vertex AI Configuration (for Gemini and embeddings)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1

# BRAVE Search API Configuration (for search-based agents)
BRAVE_API_KEY=your-brave-api-key

# Corporate Firewall / Proxy Configuration
# Uncomment and configure if behind a corporate firewall with SSL inspection

# Disable SSL verification (ONLY if behind corporate firewall with self-signed certs)
# WARNING: Only use in trusted corporate environments
# NODE_TLS_REJECT_UNAUTHORIZED=0
# SSL_VERIFY=false

# Corporate proxy settings
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,postgres,litellm,mcp-filesystem,mcp-duckduckgo

# Custom CA certificate bundle (path to corporate CA cert file)
# REQUESTS_CA_BUNDLE=/path/to/corporate-ca-bundle.crt
# CURL_CA_BUNDLE=/path/to/corporate-ca-bundle.crt
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca-bundle.crt

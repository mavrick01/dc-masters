# DC-Masters Container Toolkit Configuration
# Copy this file to .env and configure with your credentials

# Container Runtime (podman or docker)
CONTAINER_RUNTIME=podman

# PostgreSQL Configuration
POSTGRES_USER=dcmasters
POSTGRES_PASSWORD=changeme123
POSTGRES_DB=litellm

# LiteLLM Configuration
LITELLM_MASTER_KEY=sk-1234-changeme
DATABASE_URL=postgresql://dcmasters:changeme123@postgres:5432/litellm

# N8N Configuration
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme123
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=dcmasters
DB_POSTGRESDB_PASSWORD=changeme123
GENERIC_TIMEZONE=Asia/Singapore
TZ=Asia/Singapore

# Azure OpenAI Configuration (for GPT models)
# AZURE_API_KEY=your-azure-api-key
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2024-02-15-preview

# AWS Bedrock Configuration (for Claude models)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION_NAME=us-east-1

# Google Cloud / Vertex AI Configuration (for Gemini and embeddings)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1

# MCP Server Configuration
MCP_FILESYSTEM_PORT=8000
MCP_DUCKDUCKGO_PORT=8001

{
  "name": "1. Embedding Agent - Auto-embed Files",
  "nodes": [
    {
      "parameters": {
        "fieldToSplitOut": "$binary",
        "include": "allOtherFields",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        640,
        48
      ],
      "id": "e559ff41-56fb-47da-acf8-ddb7f9081d06",
      "name": "Split Out"
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": "embeddings.documents",
        "options": {
          "columnNames": {
            "values": {
              "contentColumnName": "content"
            }
          }
        }
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [
        1792,
        192
      ],
      "id": "67be40a9-e3d2-4395-a31a-1384a3457420",
      "name": "Postgres PGVector Store",
      "credentials": {
        "postgres": {
          "id": "SCWYa1kltjqr9Gmp",
          "name": "PostgreSQL - Embeddings DB"
        }
      }
    },
    {
      "parameters": {
        "projectId": {
          "__rl": true,
          "value": "={{ $env.GCP_PROJECT_ID }}",
          "mode": "id"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleVertex",
      "typeVersion": 1,
      "position": [
        1744,
        384
      ],
      "id": "688472db-343d-466e-94a1-d5f492e7fc36",
      "name": "Embeddings Google Vertex",
      "credentials": {
        "googleApi": {
          "id": "nm6QIHN5l3TQ9koi",
          "name": "Google Cloud - Vertex AI"
        }
      }
    },
    {
      "parameters": {
        "chunkOverlap": 150,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1888,
        560
      ],
      "id": "158b107d-cb29-4f6e-a847-34ae88bf711a",
      "name": "Recursive Character Text Splitter"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT EXISTS (\n    SELECT 1 FROM embeddings.documents \n    WHERE metadata->>'filehash' = '{{ $json.fileHash }}'\n) as exists,\n'{{ $node[\"Split Out\"].json.fileName }}' as \"fileName\",\n'{{ $node[\"Split Out\"].json.fileType }}' as \"fileType\",\n'{{ $node[\"Split Out\"].json.fileHash }}' as \"fileHash\";",
        "options": {}
      },
      "id": "651500b5-1f46-4e00-b845-e67f62f8a2d8",
      "name": "Check If Already Processed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        864,
        48
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "SCWYa1kltjqr9Gmp",
          "name": "PostgreSQL - Embeddings DB"
        }
      }
    },
    {
      "parameters": {
        "dataType": "binary",
        "binaryMode": "specificField",
        "binaryDataKey": "={{ $('Split Out').item.binary.data }}",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "filename",
                "value": "={{ $('Split Out').item.json.fileName }}"
              },
              {
                "name": "filetype",
                "value": "={{ $('Split Out').item.json.fileType }}"
              },
              {
                "name": "filehash",
                "value": "={{ $('Split Out').item.json.fileHash }}"
              }
            ]
          }
        }
      },
      "id": "a202229d-fb3c-497d-88b4-071496adcf66",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "position": [
        1888,
        384
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -256,
        32
      ],
      "id": "528e3068-68de-4e05-acec-79f363ecc686",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "fileSelector": "/home/node/data/import/*.*",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        -32,
        32
      ],
      "id": "eafefee7-a558-4832-8ed8-73f9d5a4c0d9",
      "name": "Read/Write Files from Disk",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "mode": "combine",
        "fieldsToMatchString": "fileName",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        416,
        48
      ],
      "id": "90ec7d5d-50d5-4e99-ab02-0f3049b72f67",
      "name": "Merge"
    },
    {
      "parameters": {
        "command": "=mv   /home/node/data/import/{{ $json.metadata.filename }} /home/node/data/shared"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2192,
        80
      ],
      "id": "956be26f-2297-4896-be73-e996540f8c0a",
      "name": "Move the File to Shared Directory"
    },
    {
      "parameters": {
        "content": "## 🛠   Workflow Logic: ##\n**Monitor:** Runs every minute via Schedule Trigger.\n**Integrity Check:** Calculates a SHA256 hash via the Crypto node to detect actual content changes.\n**Deduplication:** Queries embeddings.documents to see if the specific fileName + fileHash combo already exists.\n**Cleanup (Upsert Strategy):** * If the file is missing or changed, the workflow deletes existing records for that filename to prevent orphaned chunks.\n**AI Processing:** * Embeddings: Google Vertex AI (text-embedding-004).\n**Splitting:** Recursive Character Text Splitter (Overlap: 150).\n**Archive:** Moves the processed file from /import to /shared via mv command to keep the ingestion folder clean.\n",
        "height": 224,
        "width": 768,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        512,
        240
      ],
      "typeVersion": 1,
      "id": "35a903cb-01af-4f41-ae1a-523a834af20f",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "content": "## 🗄 Database Details:\n**Schema:** embeddings | **Table:** documents\n**Vector Column:** embedding (768 dimensions)\n**Metadata stored:** filename, filetype, filehash\n\n**⚠️ Maintenance Notes:**\nIf dimensions change in the Vertex AI node, the PostgreSQL column must be ALTERED to match.\nEnsure the Docker volumes for /import and /shared remain mounted.",
        "height": 192,
        "width": 768,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        512,
        496
      ],
      "typeVersion": 1,
      "id": "d85c633e-8d6a-4d65-b82b-f1783a249359",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "content": "## 📄 AI Ingestion & Vector Sync Pipeline\n**Description:** Automatically monitors the sandbox import directory, processes new or modified documents, and syncs them with the PostgreSQL Vector Store.",
        "height": 96,
        "width": 752
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        512,
        -80
      ],
      "typeVersion": 1,
      "id": "6c8dcd91-1929-4efb-97d6-8f34f033d0bb",
      "name": "Sticky Note3"
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"metadata\": { \"filename\":  {{ $json.fileName }} }\n}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1856,
        16
      ],
      "id": "fecb6183-a625-4f37-b4e2-f06685e92f4b",
      "name": "Map FileName to Match Embedding Output"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "e104acc3-d948-474e-a5b4-2b378d1db1a2",
              "leftValue": "={{ $json.fileName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1520,
        32
      ],
      "id": "f5fa5790-55ed-4512-a28c-1fde2022fc4a",
      "name": "If The Filename exists, then move it"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "eba30c81-1490-434a-8123-d197b9828042",
              "leftValue": "={{ $json.exists }}",
              "rightValue": "false",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1088,
        48
      ],
      "id": "e4ead149-4406-414a-832b-6320c134523c",
      "name": "If the Hash has changed",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM embeddings.documents \nWHERE metadata->>'filename' = '{{ $json.fileName }}';",
        "options": {}
      },
      "id": "bcab2189-16f6-4622-81f0-85084f0b253c",
      "name": "Delete Change File from Embeddings",
      "type": "n8n-nodes-base.postgres",

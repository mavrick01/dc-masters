# Corporate Firewall Configuration Template
# Copy the lines you need to your .env file

# =============================================================================
# QUICK FIX: Corporate Firewall with SSL Inspection
# =============================================================================
# If you see SSL certificate errors, uncomment these lines:

# Disable SSL verification (WARNING: Only for trusted corporate networks)
NODE_TLS_REJECT_UNAUTHORIZED=0
SSL_VERIFY=false

# =============================================================================
# PROXY CONFIGURATION
# =============================================================================
# If your network requires a proxy, uncomment and update:

# Without authentication:
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080

# With authentication (replace username:password):
# HTTP_PROXY=http://username:password@proxy.company.com:8080
# HTTPS_PROXY=http://username:password@proxy.company.com:8080

# Bypass proxy for internal services:
NO_PROXY=localhost,127.0.0.1,postgres,litellm,mcp-filesystem,mcp-duckduckgo,n8n

# =============================================================================
# CUSTOM CA CERTIFICATE (Recommended over disabling SSL)
# =============================================================================
# If you have your corporate CA certificate, uncomment and set path:

# REQUESTS_CA_BUNDLE=/app/certs/corporate-ca-bundle.crt
# CURL_CA_BUNDLE=/app/certs/corporate-ca-bundle.crt
# NODE_EXTRA_CA_CERTS=/app/certs/corporate-ca-bundle.crt

# Then create ./certs/ directory and place your CA bundle there
# Also update compose.yaml to mount ./certs volume

# =============================================================================
# TESTING YOUR CONFIGURATION
# =============================================================================
# After updating .env:
#   ./start-toolkit.sh stop
#   ./start-toolkit.sh start
#   ./start-toolkit.sh logs litellm | grep -i ssl
#
# See CORPORATE_FIREWALL.md for complete guide
